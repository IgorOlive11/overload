# Copie para .env e preencha com os valores do banco de desenvolvimento. Nunca use valores de produção aqui.
# O app (npm run dev) não precisa de nada: ele chama /api, que o Vite repassa para a API local na porta 3000.

# API (npm run api), conectada como overload_api.
DATABASE_URL=postgres://overload_api:SENHA@localhost:5432/overload
ORIGEM_PUBLICA=http://localhost:5173
# Sem chave, a API não envia e-mail e escreve o link no log (só fora de produção).
RESEND_API_KEY=
EMAIL_REMETENTE=Overload <nao-responda@overload.app.br>

# Migrações (npm run db:migrar), como overload_dono.
DATABASE_URL_MIGRACAO=postgres://overload_dono:SENHA@localhost:5432/overload

# Preparo do banco, uma vez (npm run db:preparar), como superusuário.
DATABASE_URL_ADMIN=postgres://postgres:SENHA@localhost:5432/overload
SENHA_OVERLOAD_DONO=
SENHA_OVERLOAD_API=

# Testes de banco e da API (npm test): um Postgres descartável, como superusuário.
DATABASE_URL_TESTE=postgres://postgres:SENHA@localhost:5432/postgres
